# Quarto: Zwischenstände beim Rendern (das Buch selbst liegt in docs/,
# die eingefrorenen Ergebnisse in _freeze/ — beide werden versioniert)
/.quarto/
/*_files/
*_cache/
**/*.quarto_ipynb

# Daten: Der ALLBUS (und andere Umfragedaten) wird nicht weitergegeben.
# Jede:r lädt ihn nach Registrierung selbst bei GESIS herunter (ZA8901)
# und legt ihn als ALLBUS2023.sav in den Projektordner.
*.sav
*.zsav
*.por
*.dta

